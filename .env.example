# Generate SECRET_KEY with: openssl rand -hex 32
APP_ENV=dev
SECRET_KEY=change-me-to-32-plus-random-bytes-via-openssl-rand-hex-32
DATABASE_URL=mysql+pymysql://couple:devpwd@127.0.0.1/couple_diary?charset=utf8mb4
DATABASE_TEST_URL=mysql+pymysql://couple:devpwd@127.0.0.1/couple_diary_test?charset=utf8mb4
# Replace with absolute paths on your machine. On Windows use forward slashes
# (e.g. C:/projects/couple-diary/.data/uploads). On Linux use /opt/... etc.
UPLOAD_DIR=/REPLACE/WITH/ABSOLUTE/PATH/uploads
BACKUP_DIR=/REPLACE/WITH/ABSOLUTE/PATH/backups
LOG_DIR=/REPLACE/WITH/ABSOLUTE/PATH/logs
SESSION_COOKIE_NAME=cdsid
SESSION_MAX_AGE_DAYS=30
COOKIE_SECURE=false
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_PDF_UPLOAD_BYTES=20971520
MAX_IMPORT_UPLOAD_BYTES=52428800
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
